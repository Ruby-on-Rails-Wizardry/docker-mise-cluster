# Bundler / gem + yarn caches (populated by bin/setup; used by Docker preferentially)
.cache/bundle/**
!.cache/bundle/.gitkeep
.cache/rubygems/**
!.cache/rubygems/.gitkeep
.cache/yarn/**
!.cache/yarn/.gitkeep
.cache/yarn-cache/**
!.cache/yarn-cache/.gitkeep
.cache/mise/

# Accidental per-app caches (must use cluster .cache/* only)
fred/.cache/
george/.cache/

vendor/bundle/
vendor/cache/

# App runtime / build artifacts
**/log/*
!**/log/.keep
**/tmp/*
!**/tmp/.keep
!**/tmp/pids/
!**/tmp/pids/.keep
**/storage/*
!**/storage/.keep
**/public/assets
**/public/packs
**/node_modules
**/app/assets/builds/*
!**/app/assets/builds/.keep

# Credentials / secrets
**/config/master.key
**/config/credentials/*.key
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*~
*.swp
*.swo
*.swn
Session.vim
.netrwhist
.idea/
.vscode/
*.code-workspace

# Coverage / test
coverage/
.rspec_status
spec/examples.txt

# Docker
.docker/

# Per-app / root Bundler local config (seeded by bin/ensure-bundle-config; not committed)
.bundle/
**/.bundle/

# Ruby
*.gem
.ruby-gemset

# Optional machine overrides (committed defaults live in .mise.env)
.mise.env.local
.task/

# cluster-tasks wire
.cluster-tasks.env
.local-gems.disabled
config/cache.env
compose.secrets.yml
.*.env
config/compose.env
.common.env
