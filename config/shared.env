# Shared non-secret app environment (committed).
# Loaded by every app via compose env_file: config/shared.env
# Do NOT put vault secrets or package-cache paths here.
#
# Topology (ports, DATABASE_URL hostnames) stays in compose.yml environment:.
# /cache package paths: ubuntu-mise image user configs + image ENV
#   (see ubuntu-mise docs/runtime-env-not-required.md)

DOCKER_COMPOSE=true
RAILS_ENV=development
NODE_ENV=development
