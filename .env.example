# Match container user to your host account for writable bind mounts.
# USER defaults to the host shell's $USER when unset (compose), else "dev".
USER=dev
DEV_UID=1000
DEV_GID=1000

# PostgreSQL major version for client tools + libpq-dev (pg gem builds).
# Default 18 is current latest stable; match your db service major when possible.
POSTGRESQL_VERSION=18

