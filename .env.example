# Match container user to your host account for writable bind mounts.
# USER defaults to the host shell's $USER when unset (compose), else "dev".
USER=dev
DEV_UID=1000
DEV_GID=1000

# Dev app image: thin layer on a local ubuntu-mise base (fred + george + dev).
# Build the base first from the docker-mise umbrella: task ubuntu:build
# (or: cd ../ubuntu-mise && ./bin/build). Then: bin/setup --docker-build
BASE_IMAGE=ubuntu-mise:dev
# Tag for the built cluster image (compose `image:`)
CLUSTER_IMAGE=wf-dev:latest
# Named volume for runtime mise installs (default shares name with ubuntu-mise cache)
# MISE_CACHE_VOLUME=ubuntu-mise-cache

# PostgreSQL major: image tag for `db` service + client/libpq in the app image.
# Default 18 is current latest stable.
POSTGRESQL_VERSION=18

# Redis major (image redis:${REDIS_VERSION}-alpine)
REDIS_VERSION=8

# Dev-only credentials for compose `db` (not for production).
POSTGRES_USER=cluster
POSTGRES_PASSWORD=cluster

# Optional host publish ports if 5432/6379 are already taken
# POSTGRES_PUBLISH_PORT=5432
# REDIS_PUBLISH_PORT=6379

