# Shared non-secret app environment (committed).
# Loaded by every app via compose env_file: config/shared.env
# Secrets: .common.env (shared) or .<app>.env — not this file.
# bin/compose does not manage .env; interpolation uses config/compose.env.
#
# Topology (ports, DATABASE_URL hostnames) stays in compose.yml environment:.
# /cache package paths: ubuntu-mise image (runtime-env-not-required.md)

DOCKER_COMPOSE=true
RAILS_ENV=development
NODE_ENV=development
