# Single source of truth for cache *relative* paths (from cluster root).
# Host: bin/cache-env prefixes with the absolute cluster root.
# Docker: compose interpolates as $HOME/wf/${VAR} (via bin/compose --env-file).

#
# Do not put host- or container-absolute paths here.

CACHE_BUNDLE=.cache/bundle
CACHE_RUBYGEMS=.cache/rubygems
CACHE_YARN_MIRROR=.cache/yarn
CACHE_YARN_FOLDER=.cache/yarn-cache
