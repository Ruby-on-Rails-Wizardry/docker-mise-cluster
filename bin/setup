#!/usr/bin/env bash
# Bootstrap this cluster after clone/copy (idempotent).
#
# Installs mise tools, downloads gems + node packages into shared host caches,
# installs them for local use, and prepares each app database listed in
# config/apps.yml. Run on the host before docker compose so containers can
# prefer those cached downloads (see bin/docker-app).
#
# Usage:
#   bin/setup
#   bin/setup --reset          # also reset app databases
#   bin/setup --docker-build   # build the Ubuntu dev image after host setup
#   bin/setup --skip-mise      # assume Ruby/Node/Yarn already on PATH
#   bin/setup --skip-js        # skip yarn install / yarn cache warm
#   bin/setup --skip-db        # skip rails db:prepare
#   bin/setup --skip-apps      # only root gems + yarn (no per-app bundle/db)
#   bin/setup --skip-cache     # install only; do not run bundle cache / package

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# shellcheck source=bin/cache-env
source "${ROOT}/bin/cache-env"
"${ROOT}/bin/cache-env" --write-yarnrc >/dev/null

SKIP_MISE=0
SKIP_JS=0
SKIP_DB=0
SKIP_APPS=0
SKIP_CACHE=0
DOCKER_BUILD=0
RESET_DB=0

for arg in "$@"; do
  case "$arg" in
    --skip-mise) SKIP_MISE=1 ;;
    --skip-js) SKIP_JS=1 ;;
    --skip-db) SKIP_DB=1 ;;
    --skip-apps) SKIP_APPS=1 ;;
    --skip-cache) SKIP_CACHE=1 ;;
    --docker-build) DOCKER_BUILD=1 ;;
    --reset) RESET_DB=1 ;;
    -h|--help)
      awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      echo "Run bin/setup --help for usage." >&2
      exit 1
      ;;
  esac
done

step() {
  printf '\n== %s ==\n' "$1"
}

run() {
  echo "+ $*"
  "$@"
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: required command not found: $1" >&2
    exit 1
  fi
}

activate_mise() {
  if command -v mise >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    eval "$(mise activate bash)"
  fi
}

link_bundle_config() {
  local target="$1"
  mkdir -p "$(dirname "${target}")"
  ln -sfn "${ROOT}/config/bundler-flags.yml" "${target}"
}

cache_gems() {
  run bundle cache --all-platforms
}

step "Cluster root"
echo "$ROOT"
step "Apps from config/apps.yml"
"${ROOT}/bin/apps" yaml

# --- mise --------------------------------------------------------------------
if [[ "$SKIP_MISE" -eq 0 ]]; then
  step "Installing mise tools (mise.toml)"
  if command -v mise >/dev/null 2>&1; then
    run mise trust "$ROOT/mise.toml" || true
    run mise install
    activate_mise
  else
    echo "warning: mise not found; using whatever Ruby/Node/Yarn are on PATH"
    echo "         install mise from https://mise.jdx.dev for pinned versions"
  fi
else
  step "Skipping mise (--skip-mise)"
  activate_mise
fi

require_cmd ruby
require_cmd bundle
if [[ "$SKIP_JS" -eq 0 ]]; then
  require_cmd node
  require_cmd yarn
fi

echo "ruby:  $(ruby -v)"
echo "bundle: $(bundle -v)"
if [[ "$SKIP_JS" -eq 0 ]]; then
  echo "node:  $(node -v)"
  echo "yarn:  $(yarn -v)"
fi

# --- cache directories -------------------------------------------------------
step "Ensuring shared cache directories (from config/cache-layout.env)"
mkdir -p \
  "${CACHE_BUNDLE}" \
  "${CACHE_RUBYGEMS}" \
  "${CACHE_YARN_MIRROR}" \
  "${CACHE_YARN_FOLDER}"
touch \
  "${CACHE_BUNDLE}/.gitkeep" \
  "${CACHE_RUBYGEMS}/.gitkeep" \
  "${CACHE_YARN_MIRROR}/.gitkeep" \
  "${CACHE_YARN_FOLDER}/.gitkeep"
echo "BUNDLE_PATH=${BUNDLE_PATH}"
echo "BUNDLE_CACHE_PATH=${BUNDLE_CACHE_PATH}"
echo "YARN_CACHE_FOLDER=${YARN_CACHE_FOLDER}"
echo "YARN_OFFLINE_MIRROR=${YARN_OFFLINE_MIRROR}"

# Bundler flags SSOT → root + each app
link_bundle_config "${ROOT}/.bundle/config"
while IFS= read -r app_path; do
  [[ -z "${app_path}" ]] && continue
  if [[ -d "${ROOT}/${app_path}" ]]; then
    link_bundle_config "${ROOT}/${app_path}/.bundle/config"
  fi
done < <("${ROOT}/bin/apps" paths)

# --- root gems ---------------------------------------------------------------
if [[ -f "${ROOT}/Gemfile" ]]; then
  step "Installing root gems → shared bundle path"
  if bundle check >/dev/null 2>&1; then
    echo "Root bundle already satisfied"
  else
    run bundle install
  fi
  if [[ "$SKIP_CACHE" -eq 0 ]]; then
    step "Packaging root gems into rubygems download cache"
    cache_gems
  fi
fi

# --- app gems + databases ----------------------------------------------------
setup_app() {
  local app_path="$1"
  local app_root="${ROOT}/${app_path}"

  if [[ ! -d "${app_root}" ]]; then
    echo "warning: app path missing (submodule not initialized?): ${app_path}"
    return 0
  fi
  if [[ ! -f "${app_root}/Gemfile" ]]; then
    echo "warning: no Gemfile in ${app_path}; skipping"
    return 0
  fi

  step "Setting up ${app_path}"
  (
    cd "${app_root}"
    if bundle check >/dev/null 2>&1; then
      echo "${app_path} bundle already satisfied"
    else
      run bundle install
    fi

    if [[ "$SKIP_CACHE" -eq 0 ]]; then
      echo "Packaging ${app_path} gems into rubygems download cache"
      cache_gems
    fi

    if [[ "$SKIP_DB" -eq 0 ]] && [[ -x bin/rails || -f bin/rails ]]; then
      if [[ "$RESET_DB" -eq 1 ]]; then
        run bin/rails db:prepare
        run bin/rails db:reset
      else
        run bin/rails db:prepare
      fi
      run bin/rails log:clear tmp:clear || true
    else
      echo "Skipping database for ${app_path}"
    fi
  )
}

if [[ "$SKIP_APPS" -eq 0 ]]; then
  while IFS= read -r app_path; do
    [[ -z "${app_path}" ]] && continue
    setup_app "${app_path}"
  done < <("${ROOT}/bin/apps" paths)
else
  step "Skipping app setup (--skip-apps)"
fi

# --- classic Yarn 1.x --------------------------------------------------------
if [[ "$SKIP_JS" -eq 0 ]]; then
  yarn_major="$(yarn --version | cut -d. -f1 || echo 0)"
  if [[ "$yarn_major" -ne 1 ]]; then
    echo "error: classic Yarn 1.x required (got $(yarn --version))" >&2
    echo "       check mise.toml (yarn = \"1.22.22\") and re-run mise install" >&2
    exit 1
  fi

  if [[ -f "${ROOT}/package.json" ]]; then
    step "Installing Yarn 1 workspaces (offline-mirror → .cache/yarn)"
    run yarn install --frozen-lockfile 2>/dev/null || run yarn install

    if [[ "$SKIP_CACHE" -eq 0 ]]; then
      step "Verifying classic Yarn offline mirror (--offline)"
      if yarn install --frozen-lockfile --offline; then
        echo "Yarn offline mirror is complete"
      else
        echo "warning: yarn --offline failed; re-running online install to fill mirror"
        run yarn install
        if yarn install --frozen-lockfile --offline; then
          echo "Yarn offline mirror is complete after refill"
        else
          echo "warning: yarn offline mirror still incomplete"
        fi
      fi
    fi
  else
    echo "No root package.json; skipping yarn"
  fi
else
  step "Skipping Yarn install (--skip-js)"
fi

# --- summary -----------------------------------------------------------------
step "Cache summary"
gem_count=0
yarn_count=0
if [[ -d .cache/rubygems ]]; then
  gem_count="$(find .cache/rubygems -type f \( -name '*.gem' -o -name '*.gemspec' \) 2>/dev/null | wc -l | tr -d ' ')"
fi
if [[ -d .cache/yarn ]]; then
  yarn_count="$(find .cache/yarn -type f ! -name '.gitkeep' 2>/dev/null | wc -l | tr -d ' ')"
fi
echo "  .cache/rubygems   : ${gem_count} packaged gem artifacts"
echo "  .cache/bundle     : shared install tree"
echo "  .cache/yarn       : ${yarn_count} classic offline-mirror tarballs"
echo "  .cache/yarn-cache : classic yarn --cache-folder"
echo "  node_modules      : $( [[ -d node_modules ]] && echo present || echo missing )"

if [[ "$DOCKER_BUILD" -eq 1 ]]; then
  step "Building Docker image (wf-dev)"
  require_cmd docker
  run "${ROOT}/bin/compose" build
fi

step "Setup complete"
mapfile -t APP_NAMES < <("${ROOT}/bin/apps" names)
cat <<EOF
Host tools and download caches are ready.

  Layout:         ${ROOT}/config/cache-layout.env
  Apps:           ${ROOT}/config/apps.yml  (${APP_NAMES[*]:-none})
  Gem installs:   ${BUNDLE_PATH}
  Gem downloads:  ${BUNDLE_CACHE_PATH}
  Yarn mirror:    ${YARN_OFFLINE_MIRROR}
  Yarn cache:     ${YARN_CACHE_FOLDER}

Recommended flow:
  bin/setup
  bin/compose up ${APP_NAMES[*]:-fred george}
  # always use bin/compose so cache-layout.env is loaded

Re-run anytime; the script is idempotent.
EOF
