# Project defaults for host UX (loaded by mise.toml and bin/lib.sh).
# Shell exports win over this file. Do not put secrets here — commit only safe defaults.
#
# Aligns with prebuilt ubuntu-mise:dev (client major) and compose `db` image tag:
#   POSTGRESQL_VERSION=17 task up -- fred
#   POSTGRESQL_VERSION= task up -- fred   # only if you intentionally skip PG client in base

# Current PostgreSQL major (stable). Used for compose `db` image and documented
# parity with the sibling ubuntu-mise image build-arg.
POSTGRESQL_VERSION=18

# Prebuilt base for fred / george / dev (local only; never pulled).
IMAGE=ubuntu-mise:dev
# Shared /cache volume name (same default as ubuntu-mise).
CACHE_VOLUME=ubuntu-mise-cache
# Container user must match the user in the base image (default ubuntu-mise build).
IMAGE_USER=dev
