# Generated knobs also live in .mise.env (POSTGRESQL_VERSION, IMAGE, …).
# bin/compose regenerates .env on each run; this file documents overrides.

# Prebuilt base for apps + dev shell (local only — never pulled)
IMAGE=ubuntu-mise:dev
CACHE_VOLUME=ubuntu-mise-cache
# Defaults: host login name + id -u / id -g (written by bin/compose).
# Must match the user baked into ubuntu-mise:dev (build base with host defaults).
# IMAGE_USER=dev
# DEV_UID=1000
# DEV_GID=1000

# PostgreSQL major: compose `db` image tag (postgres:N) + parity with base image client
POSTGRESQL_VERSION=18

# Redis major (image redis:${REDIS_VERSION}-alpine)
REDIS_VERSION=8

# Dev-only credentials for compose `db` (not for production).
POSTGRES_USER=cluster
POSTGRES_PASSWORD=cluster

# Compose project name: omit to use the directory name (recommended).
# COMPOSE_PROJECT_NAME=wf

# Optional host publish ports if 5432/6379 are already taken
# POSTGRES_PUBLISH_PORT=5432
# REDIS_PUBLISH_PORT=6379
