#!/usr/bin/env bash
# Managed by cluster-tasks install — standalone copy (no sibling required)
# Ensure each Gemfile project has its own .bundle/config (not a shared symlink).
#
# Seed from config/bundler-flags.yml when missing. Paths stay in ENV
# (BUNDLE_PATH, BUNDLE_CACHE_PATH, BUNDLE_USER_HOME on /cache).
#
# Always enforce multi-app shared-path safety flags on every run:
#   BUNDLE_CLEAN=false   — do not prune installed gems for other apps
#   BUNDLE_NO_PRUNE=true — do not prune shared BUNDLE_CACHE_PATH on `bundle cache`
#     (otherwise app A cache drops app B's .gem files → "Removing outdated …")
#
# Usage:
#   bin/ensure-bundle-config           # all apps (+ root if Gemfile)
#   bin/ensure-bundle-config app1 app2  # named app paths only
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

FLAGS="${ROOT}/config/bundler-flags.yml"
[[ -f "${FLAGS}" ]] || die "missing ${FLAGS}"

# Force a BUNDLE_* key in a YAML-ish .bundle/config (Bundler config format).
force_bundle_key() {
  local cfg=$1 key=$2 val=$3
  if grep -qE "^${key}:" "${cfg}" 2>/dev/null; then
    if grep -qE "^${key}:[[:space:]]*\"?${val}\"?" "${cfg}"; then
      return 0
    fi
    sed -i "s/^${key}:.*/${key}: \"${val}\"/" "${cfg}"
    log "set ${key}=${val} in ${cfg#"${ROOT}"/}"
  else
    printf '%s: "%s"\n' "${key}" "${val}" >>"${cfg}"
    log "appended ${key}=${val} to ${cfg#"${ROOT}"/}"
  fi
}

patch_multi_app_safety() {
  local cfg=$1
  [[ -f "${cfg}" ]] || return 0
  force_bundle_key "${cfg}" "BUNDLE_CLEAN" "false"
  force_bundle_key "${cfg}" "BUNDLE_NO_PRUNE" "true"
}

seed_one() {
  local dir=$1
  local rel cfg
  rel="${dir#"${ROOT}"/}"
  [[ "${dir}" == "${ROOT}" ]] && rel="."
  cfg="${dir}/.bundle/config"

  mkdir -p "${dir}/.bundle"

  if [[ -L "${cfg}" ]]; then
    log "replace shared symlink ${rel}/.bundle/config with a private copy"
    rm -f "${cfg}"
  fi

  if [[ ! -f "${cfg}" ]]; then
    cp "${FLAGS}" "${cfg}"
    log "seeded ${rel}/.bundle/config from config/bundler-flags.yml"
  fi

  patch_multi_app_safety "${cfg}"
}

if [[ $# -gt 0 ]]; then
  for name in "$@"; do
    if [[ -d "${ROOT}/${name}" ]]; then
      seed_one "${ROOT}/${name}"
    elif [[ -d "${name}" ]]; then
      seed_one "$(cd "${name}" && pwd)"
    else
      die "unknown app path: ${name}"
    fi
  done
else
  if [[ -f "${ROOT}/Gemfile" ]]; then
    seed_one "${ROOT}"
  fi
  while IFS= read -r app_path; do
    [[ -z "${app_path}" ]] && continue
    [[ -f "${ROOT}/${app_path}/Gemfile" ]] || continue
    seed_one "${ROOT}/${app_path}"
  done < <("${ROOT}/bin/apps" paths)
fi
