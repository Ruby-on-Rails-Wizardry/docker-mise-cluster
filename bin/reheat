#!/usr/bin/env bash
# Managed by cluster-tasks install — standalone copy (no sibling required)
# Run docker-prepare for each app as a normal Compose **service** (not compose run).
#
# Uses `compose up` so Desktop shows e.g. `wf / ross` (or ross Exited after prepare),
# never `ross-run-randomid`.
#
#   bin/compose up -d db redis
#   for each app:
#     overlay PREPARE_ONLY=1 → compose up --no-deps --force-recreate APP
#     docker-app runs prepare then exits (no server)
#
# Usage:
#   bin/reheat
#   bin/reheat fred ron
#   task reheat
#   COMPOSE_PROJECT_NAME=wf task reheat
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
  cat <<'EOF'
Usage: bin/reheat [APP…]

  Prepare each app via its compose service definition (same name as `task up`).
  Leaves the service container as project/APP (Exited 0 after prepare) — not
  a one-off "APP-run-…". Disk/db state persists on /cache, bind mount, and db.

  Starts db + redis if needed. Does not leave the Rails server running.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

ensure_image
ensure_cache_volume

if [[ -x "${ROOT}/bin/env-files" ]]; then
  "${ROOT}/bin/env-files" write 2>/dev/null || true
fi

APPS=()
if [[ $# -gt 0 ]]; then
  APPS=("$@")
else
  [[ -x "${ROOT}/bin/apps" ]] || die "missing bin/apps — re-run wire/install"
  mapfile -t APPS < <("${ROOT}/bin/apps" names)
fi
[[ ${#APPS[@]} -gt 0 ]] || die "no apps to reheat (config/apps.yml empty?)"

log "reheat: project=${COMPOSE_PROJECT_NAME} (service names, not compose-run one-offs)"

"${ROOT}/bin/compose" up -d db 2>/dev/null || true
"${ROOT}/bin/compose" up -d redis 2>/dev/null || true

overlay="$(mktemp "${TMPDIR:-/tmp}/reheat-overlay.XXXXXX.yml")"
cleanup() { rm -f "${overlay}"; }
trap cleanup EXIT

failures=()
for app in "${APPS[@]}"; do
  log "reheat: ${app} → compose up (PREPARE_ONLY, service name=${app})"
  cat >"${overlay}" <<EOF
# Generated by bin/reheat — do not commit
services:
  ${app}:
    environment:
      PREPARE_ONLY: "1"
    restart: "no"
EOF

  # Normal service container name (project-app-1), not project-app-run-*.
  # --abort-on-container-exit waits until docker-prepare finishes and exits 0.
  if ! COMPOSE_ADD_FILES="${overlay}" \
    "${ROOT}/bin/compose" up --no-deps --force-recreate \
      --abort-on-container-exit --exit-code-from "${app}" \
      "${app}"; then
    failures+=("${app}")
    log "error: reheat failed for ${app}"
  else
    log "reheat: ${app} ok (service ${COMPOSE_PROJECT_NAME}-${app}-* prepared, server not started)"
  fi
done

if ((${#failures[@]})); then
  die "reheat failed for: ${failures[*]}"
fi
log "reheat complete (${#APPS[@]} app(s), project=${COMPOSE_PROJECT_NAME})"
