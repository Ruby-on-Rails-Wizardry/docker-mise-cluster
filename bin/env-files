#!/usr/bin/env bash
# Managed by cluster-tasks install — standalone copy (no sibling required)
# Manage layered env for multi-app compose: shared non-secrets vs vault secrets.
#
#   bin/env-files status
#   bin/env-files write     # shared.env seed + compose.secrets.yml (+ cache.env stub)
#   bin/env-files list      # print shared env_file paths (for docs/debug)
#   task env:files -- status|write
#
# Manifest: config/env.yml  (see templates/env.yml.example / docs/ENV.md)
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

MANIFEST="${ROOT}/config/env.yml"
SHARED_ENV="${ROOT}/config/shared.env"
SECRETS_COMPOSE_DEFAULT="compose.secrets.yml"

usage() {
  awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

log() { printf 'env-files: %s\n' "$*"; }

cmd="${1:-status}"
shift || true

# Ruby helper: read manifest + apps.yml, emit actions
run_ruby() {
  local mode=$1
  ruby -r yaml -r pathname -e '
root = Pathname(ARGV[0])
mode = ARGV[1]
manifest_path = root.join("config/env.yml")
apps_path = root.join("config/apps.yml")

manifest = if manifest_path.file?
  YAML.safe_load(manifest_path.read, aliases: true) || {}
else
  {
    "shared" => ["config/shared.env"],
    "shared_secrets" => [".common.env"],
    "app_secrets" => {},
    "options" => {},
  }
end

opts = manifest["options"] || {}
shared = Array(manifest["shared"] || ["config/shared.env"])
shared_secrets = Array(manifest["shared_secrets"].nil? ? [".common.env"] : manifest["shared_secrets"])
app_secrets = manifest["app_secrets"] || {}
secrets_compose = opts["secrets_compose"] || "compose.secrets.yml"
require_secrets = !!opts["require_secrets"]

apps = []
if apps_path.file?
  cfg = YAML.safe_load(apps_path.read, aliases: true) || {}
  apps = (cfg["apps"] || []).map { |a| a.is_a?(Hash) ? a["name"].to_s : a.to_s }.reject(&:empty?)
end

def exists?(root, rel)
  return false if rel.nil? || rel.to_s.empty?
  root.join(rel).file?
end

case mode
when "list-shared"
  shared.each { |p| puts p }
when "status"
  puts "manifest: #{manifest_path.file? ? manifest_path : "(defaults — no config/env.yml)"}"
  puts "secrets_compose: #{secrets_compose}"
  puts "require_secrets: #{require_secrets}"
  puts
  puts "shared non-secrets (compose x-app env_file — commit these):"
  shared.each do |p|
    flag = exists?(root, p) ? "ok" : "MISSING"
    puts "  [#{flag}] #{p}"
  end
  puts
  puts "shared secrets (.common.env etc — every app via compose.secrets.yml; gitignore):"
  if shared_secrets.empty?
    puts "  (none)"
  else
    shared_secrets.each do |p|
      flag = exists?(root, p) ? "ok" : (require_secrets ? "MISSING" : "absent")
      puts "  [#{flag}] #{p}"
    end
  end
  puts
  puts "app_secrets (vault — per service):"
  apps.each do |name|
    rel = app_secrets[name] || app_secrets[name.to_sym] || ".#{name}.env"
    rel = rel.to_s
    flag = exists?(root, rel) ? "ok" : (require_secrets ? "MISSING" : "absent")
    puts "  [#{flag}] #{name} → #{rel}"
  end
  puts "  (no apps in config/apps.yml)" if apps.empty?
when "write-secrets-compose"
  lines = []
  lines << "# Generated by bin/env-files write — do not edit by hand."
  lines << "# Multi-file merge appends these env_file entries onto compose.yml services."
  lines << "# Manifest: config/env.yml  |  regenerate: bin/env-files write"
  lines << "#"
  lines << "services:"

  any = false
  apps.each do |name|
    files = []
    shared_secrets.each do |p|
      p = p.to_s
      if exists?(root, p)
        files << p
      elsif require_secrets
        warn "env-files: required shared secret missing: #{p}"
        exit 1
      end
    end
    rel = (app_secrets[name] || app_secrets[name.to_sym] || ".#{name}.env").to_s
    if exists?(root, rel)
      files << rel
    elsif require_secrets
      warn "env-files: required app secret missing: #{rel} (app #{name})"
      exit 1
    end
    next if files.empty?
    any = true
    lines << "  #{name}:"
    lines << "    env_file:"
    files.each { |f| lines << "      - #{f}" }
  end

  out = root.join(secrets_compose)
  if any
    out.write(lines.join("\n") + "\n")
    warn "env-files: wrote #{out} (secret env_file fragment)"
    puts out.to_s
  else
    # No secret files present — remove stale fragment so compose does not require it
    if out.file?
      out.delete
      warn "env-files: removed #{out} (no secret env files present)"
    else
      warn "env-files: no secret env files — skip #{secrets_compose}"
    end
    puts ""
  end
else
  warn "unknown mode #{mode}"
  exit 1
end
' "${ROOT}" "${mode}"
}

case "${cmd}" in
  status|st)
    run_ruby status
    ;;
  list|list-shared)
    run_ruby list-shared
    ;;
  write)
    write_cache_env_file "${ROOT}/config/cache.env"
    if [[ ! -f "${SHARED_ENV}" ]]; then
      mkdir -p "${ROOT}/config"
      if [[ -n "${CLUSTER_TASKS_ROOT:-}" && -f "${CLUSTER_TASKS_ROOT}/templates/shared.env.example" ]]; then
        cp "${CLUSTER_TASKS_ROOT}/templates/shared.env.example" "${SHARED_ENV}"
        log "seeded ${SHARED_ENV} from template"
      else
        cat >"${SHARED_ENV}" <<'EOF'
# Shared non-secret app environment (committed).
DOCKER_COMPOSE=true
RAILS_ENV=development
NODE_ENV=development
EOF
        log "seeded ${SHARED_ENV}"
      fi
    fi
    if [[ ! -f "${MANIFEST}" ]]; then
      mkdir -p "${ROOT}/config"
      if [[ -n "${CLUSTER_TASKS_ROOT:-}" && -f "${CLUSTER_TASKS_ROOT}/templates/env.yml.example" ]]; then
        cp "${CLUSTER_TASKS_ROOT}/templates/env.yml.example" "${MANIFEST}"
        log "seeded ${MANIFEST} from template"
      else
        cat >"${MANIFEST}" <<'EOF'
shared:
  - config/shared.env
shared_secrets:
  - .common.env
app_secrets: {}
options:
  require_secrets: false
  secrets_compose: compose.secrets.yml
EOF
        log "seeded ${MANIFEST}"
      fi
    fi
    run_ruby write-secrets-compose
    log "done"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "env-files: unknown command: ${cmd}" >&2
    usage >&2
    exit 1
    ;;
esac
