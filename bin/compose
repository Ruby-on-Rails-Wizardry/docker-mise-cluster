#!/usr/bin/env bash
# docker compose wrapper for the multi-app cluster.
# - Writes .env (IMAGE, POSTGRESQL_VERSION, TZ, …)
# - Ensures prebuilt ubuntu-mise:dev + shared cache volume
# - Uses project compose.yml (Compose default discovery)
#
#   bin/compose up                    # all services defined in compose.yml
#   bin/compose up $(bin/apps names-oneline)
#   bin/compose --profile dev run --rm dev
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

ENV_FILE="${COMPOSE_ENV_FILE:-${ROOT}/.env}"
COMPOSE_FILE="${COMPOSE_FILE:-}"

if [[ -n "${COMPOSE_FILE}" ]]; then
  [[ -f "${COMPOSE_FILE}" ]] || die "missing ${COMPOSE_FILE}"
elif [[ ! -f "${ROOT}/compose.yml" && ! -f "${ROOT}/compose.yaml" ]]; then
  die "missing ${ROOT}/compose.yml"
fi

require_docker
docker compose version >/dev/null 2>&1 || die "docker compose plugin not available"

ensure_image
ensure_cache_volume

tz="$(host_timezone)"
{
  cat <<EOF
# Generated by bin/compose — do not commit (see .gitignore / .env.example / .mise.env)
IMAGE=${IMAGE}
TZ=${tz}
POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-18}
REDIS_VERSION=${REDIS_VERSION:-8}
POSTGRES_USER=${POSTGRES_USER:-cluster}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-cluster}
EOF
} >"${ENV_FILE}"
log "wrote ${ENV_FILE} (IMAGE=${IMAGE} POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-18})"

compose_args=(
  --project-directory "${ROOT}"
  --env-file "${ENV_FILE}"
)
if [[ -n "${COMPOSE_FILE}" ]]; then
  compose_args+=(-f "${COMPOSE_FILE}")
fi

# shellcheck disable=SC2086
exec docker compose "${compose_args[@]}" ${COMPOSE_OPTS:-} "$@"
