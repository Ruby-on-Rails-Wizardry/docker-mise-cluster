#!/usr/bin/env bash
# Managed by cluster-tasks install — standalone copy (no sibling required)
# docker compose wrapper for the multi-app cluster.
# - Writes config/compose.env (IMAGE, POSTGRESQL_VERSION, TZ, WORK_MOUNT, …)
#   for compose *interpolation* only — does NOT touch user .env
# - Seeds config/shared.env / .common.env awareness + compose.secrets.yml (env-files)
# - Ensures prebuilt ubuntu-mise:dev + shared cache volume
#
# App env layers (docs/ENV.md):
#   config/shared.env  — non-secrets, committed, compose env_file on x-app
#   .common.env        — shared secrets (vault), via compose.secrets.yml
#   .<app>.env         — per-app secrets, via compose.secrets.yml
#
#   bin/compose up                    # all services defined in compose.yml
#   bin/compose up $(bin/apps names-oneline)
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

# Generated compose interpolation file — never overwrite user-managed .env
ENV_FILE="${COMPOSE_ENV_FILE:-${ROOT}/config/compose.env}"
COMPOSE_FILE="${COMPOSE_FILE:-}"

if [[ -n "${COMPOSE_FILE}" ]]; then
  [[ -f "${COMPOSE_FILE}" ]] || die "missing ${COMPOSE_FILE}"
elif [[ ! -f "${ROOT}/compose.yml" && ! -f "${ROOT}/compose.yaml" ]]; then
  die "missing ${ROOT}/compose.yml"
fi

require_docker
docker compose version >/dev/null 2>&1 || die "docker compose plugin not available"

ensure_image
ensure_cache_volume

# Layered env: shared seed + secrets fragment (docs/ENV.md)
if [[ -x "${ROOT}/bin/env-files" ]]; then
  "${ROOT}/bin/env-files" write
elif [[ -n "${CLUSTER_TASKS_ROOT:-}" && -x "${CLUSTER_TASKS_ROOT}/bin/env-files" ]]; then
  CLUSTER_ROOT="${ROOT}" "${CLUSTER_TASKS_ROOT}/bin/env-files" write
else
  write_cache_env_file "${ROOT}/config/cache.env"
fi

tz="$(host_timezone)"
mkdir -p "$(dirname "${ENV_FILE}")"
{
  cat <<EOF
# Generated by bin/compose — do not commit (gitignored).
# Compose project interpolation only (IMAGE, WORK_MOUNT, db defaults).
# Does not replace user .env. App secrets: .common.env / .<app>.env
# App non-secrets: config/shared.env
IMAGE=${IMAGE}
TZ=${tz}
POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-18}
REDIS_VERSION=${REDIS_VERSION:-8}
POSTGRES_USER=${POSTGRES_USER:-cluster}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-cluster}
WORK_MOUNT=${WORK_MOUNT:-/work}
WORKSPACE=${WORK_MOUNT}
EOF
} >"${ENV_FILE}"
log "wrote ${ENV_FILE} (IMAGE=${IMAGE} WORK_MOUNT=${WORK_MOUNT:-/work}; left .env untouched)"

compose_args=(
  --project-directory "${ROOT}"
  --env-file "${ENV_FILE}"
)
if [[ -n "${COMPOSE_FILE}" ]]; then
  compose_args+=(-f "${COMPOSE_FILE}")
else
  if [[ -f "${ROOT}/compose.yml" ]]; then
    compose_args+=(-f "${ROOT}/compose.yml")
  elif [[ -f "${ROOT}/compose.yaml" ]]; then
    compose_args+=(-f "${ROOT}/compose.yaml")
  fi
  # Vault / per-app secrets: multi-file merge appends env_file (see bin/env-files)
  if [[ -f "${ROOT}/compose.secrets.yml" ]]; then
    compose_args+=(-f "${ROOT}/compose.secrets.yml")
    log "including compose.secrets.yml"
  fi
fi

# shellcheck disable=SC2086
exec docker compose "${compose_args[@]}" ${COMPOSE_OPTS:-} "$@"
