#!/usr/bin/env bash
# docker compose wrapper for the multi-app cluster.
# - Loads config/cache-layout.env for ${CACHE_*} interpolation
# - Writes .env (IMAGE, POSTGRESQL_VERSION, UID, TZ, …) for compose
# - Ensures prebuilt ubuntu-mise:dev + shared /cache volume
#
#   bin/compose up fred
#   bin/compose up fred george
#   bin/compose --profile dev run --rm dev
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

LAYOUT="${ROOT}/config/cache-layout.env"
COMPOSE_FILE="${COMPOSE_FILE:-${ROOT}/docker-compose.yml}"
ENV_FILE="${COMPOSE_ENV_FILE:-${ROOT}/.env}"

if [[ ! -f "${LAYOUT}" ]]; then
  die "missing ${LAYOUT}"
fi
if [[ ! -f "${COMPOSE_FILE}" ]]; then
  die "missing ${COMPOSE_FILE}"
fi

require_docker
docker compose version >/dev/null 2>&1 || die "docker compose plugin not available"

ensure_image
ensure_cache_volume

tz="$(host_timezone)"
# Merge generated keys with any operator-only keys already in .env carefully:
# always regenerate the known block so IMAGE / PG version stay consistent.
# Do not force COMPOSE_PROJECT_NAME — Docker defaults to the project directory name.
{
  cat <<EOF
# Generated by bin/compose — do not commit (see .gitignore / .env.example / .mise.env)
IMAGE=${IMAGE}
CACHE_VOLUME=${CACHE_VOLUME}
IMAGE_USER=${IMAGE_USER}
DEV_UID=${DEV_UID}
DEV_GID=${DEV_GID}
TZ=${tz}
POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-18}
REDIS_VERSION=${REDIS_VERSION:-8}
POSTGRES_USER=${POSTGRES_USER:-cluster}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-cluster}
# Back-compat aliases used by older docs
USER=${IMAGE_USER}
BASE_IMAGE=${IMAGE}
MISE_CACHE_VOLUME=${CACHE_VOLUME}
EOF
  # Only write project name when the operator explicitly set it (env / .mise.env.local).
  if [[ -n "${COMPOSE_PROJECT_NAME:-}" ]]; then
    printf 'COMPOSE_PROJECT_NAME=%s\n' "${COMPOSE_PROJECT_NAME}"
  fi
} >"${ENV_FILE}"
log "wrote ${ENV_FILE} (IMAGE=${IMAGE} IMAGE_USER=${IMAGE_USER} POSTGRESQL_VERSION=${POSTGRESQL_VERSION:-18} project=${COMPOSE_PROJECT_EFFECTIVE})"

# shellcheck disable=SC2086
exec docker compose \
  --project-directory "${ROOT}" \
  --env-file "${LAYOUT}" \
  --env-file "${ENV_FILE}" \
  -f "${COMPOSE_FILE}" \
  ${COMPOSE_OPTS:-} \
  "$@"
