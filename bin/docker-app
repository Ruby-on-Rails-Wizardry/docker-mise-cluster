#!/usr/bin/env bash
# Managed by cluster-tasks install — standalone copy (no sibling required)
# Start a Rails app inside the Ubuntu+mise dev container.
#
# 1. bin/docker-prepare  — mise, bundle, yarn, wait DB, migrate, optional hook
# 2. exec long-running process (rails server, or foreman if a Procfile is set)
#
# Prefer a prior `bin/warm` / `bin/reheat` so prepare is mostly a no-op at boot.
set -euo pipefail

PORT="${PORT:-3000}"
APP_NAME="$(basename "$(pwd)")"

WORK_MOUNT="${WORK_MOUNT:-${WORKSPACE:-/work}}"
export WORK_MOUNT
export WORKSPACE="${WORKSPACE:-${WORK_MOUNT}}"
CLUSTER_ROOT="${WORKSPACE}"
if [[ ! -f "${CLUSTER_ROOT}/bin/docker-prepare" && ! -f "${CLUSTER_ROOT}/bin/docker-app" ]]; then
  CLUSTER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

PREPARE="${CLUSTER_ROOT}/bin/docker-prepare"
if [[ ! -x "${PREPARE}" ]]; then
  PREPARE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/docker-prepare"
fi
if [[ ! -x "${PREPARE}" ]]; then
  echo "error: ${APP_NAME}: docker-prepare not found (re-run cluster-tasks wire/install)" >&2
  exit 1
fi

echo "== ${APP_NAME}: docker-prepare"
# shellcheck disable=SC1090
# Run as a process (not source) so set -e / cwd stay predictable.
"${PREPARE}"

# Long-running process: foreman when a Procfile is available, else rails server.
PROCFILE="${PROCFILE:-}"
if [[ -z "${PROCFILE}" ]]; then
  for candidate in Procfile.wf Procfile.dev Procfile; do
    if [[ -f "${candidate}" ]]; then
      PROCFILE="${candidate}"
      break
    fi
  done
fi

rm -f tmp/pids/server.pid 2>/dev/null || true

if [[ -n "${PROCFILE}" ]] && command -v foreman >/dev/null 2>&1; then
  echo "== ${APP_NAME}: foreman start -f ${PROCFILE}"
  exec foreman start -f "${PROCFILE}"
fi

if [[ -n "${PROCFILE}" ]] && ! command -v foreman >/dev/null 2>&1; then
  echo "== ${APP_NAME}: ${PROCFILE} present but foreman not on PATH; using rails server" >&2
fi

echo "== ${APP_NAME}: rails server -b 0.0.0.0 -p ${PORT}"
exec bin/rails server -b 0.0.0.0 -p "${PORT}"
